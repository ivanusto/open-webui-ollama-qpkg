# ============================================================
#  Open WebUI + Ollama QPKG configuration
#  File location on the NAS: <QPKG install dir>/openwebui-ollama.conf
#  Apply changes with:  /etc/init.d/openwebui-ollama.sh restart
#  (or restart the app from App Center). Only containers whose
#  settings changed are recreated; models and chat data are kept.
# ============================================================

# --- Images ---------------------------------------------------
# Pinned in images.lock (repository:tag@sha256:...). Override here
# only if you want to run a different version; a floating tag works
# but is flagged as unpinned on the status page and in diag.
#OLLAMA_IMAGE=""
#WEBUI_IMAGE=""

# --- Ollama (backend) -----------------------------------------
# Set to "false" to run no local Ollama at all and point Open WebUI at
# Ollama on other machines with OLLAMA_BASE_URLS below. On an existing
# install, also remove the local address in Admin Settings > Connections.
#ENABLE_OLLAMA="true"
#OLLAMA_CONTAINER_NAME="owui-ollama"

# Model storage (/root/.ollama inside the container). Models are large;
# point this at a volume with enough free space.
#OLLAMA_DATA_PATH="/share/CACHEDEV1_DATA/OpenWebUIOllama/ollama"

# Publish the raw Ollama API (11434) to the LAN. Leave empty (default)
# to keep it reachable only from the open-webui container.
#OLLAMA_PUBLISH_PORT=""

#OLLAMA_NUM_PARALLEL=""
#OLLAMA_MAX_LOADED_MODELS=""
#OLLAMA_EXTRA_ARGS=""

# --- GPU acceleration --------------------------------------------
# auto (default): use the NVIDIA GPU if Container Station's docker
#   reports an nvidia runtime, otherwise fall back to CPU.
# on:  always pass --gpus all (fails loudly if no GPU runtime present).
# off: always run CPU-only.
#GPU_MODE="auto"

# --- Open WebUI (frontend) --------------------------------------
#WEBUI_CONTAINER_NAME="owui-frontend"
#WEBUI_DATA_PATH="/share/CACHEDEV1_DATA/OpenWebUIOllama/webui"

# Port exposed on the NAS. The App Center icon link follows this value.
# (WEBUI_PORT from older .conf files is still honoured.)
#WEB_PORT="3000"

# Session signing key. Generated once on first start and saved below by
# the service script. Do not share this value.
#WEBUI_SECRET_KEY=""

#WEBUI_PIDS_LIMIT="512"
#WEBUI_EXTRA_ARGS=""

# Remote Ollama instances, semicolon-separated. While ENABLE_OLLAMA is
# true the local container is added after them, as a fallback. Each
# remote Ollama must listen on the LAN (OLLAMA_HOST=0.0.0.0:11434).
# Open WebUI reads the Ollama addresses on its first start only and keeps
# them in its database; after that, change them in Admin Settings >
# Connections (editing this line has no effect on an existing install).
#OLLAMA_BASE_URLS="http://192.168.1.20:11434;http://192.168.1.30:11434"

# --- Shared ---------------------------------------------------
#NETWORK_NAME="owui-net"
#TZ="Asia/Taipei"
#STOP_TIMEOUT="60"
#CS_WAIT_TIMEOUT="900"
